<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gosi_wizard_form" model="ir.ui.view">
            <field name="name">gosi.monthly.wizard.form</field>
            <field name="model">gosi.monthly.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate Monthly GOSI Report">
                    <sheet>
                        <group>
                            <field name="period_date"/>
                            <field name="company_id"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_generate_gosi" string="Generate GOSI Report"
                            type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
